{
  "name": "tsx-data-flow",
  "version": "0.1.0",
  "description": "Static render-path data-flow analyzer for TypeScript/TSX (Solid/SolidStart-aware) UI code. Builds a typed graph from source values to JSX render sinks and ranks high-leverage cleanup work.",
  "type": "module",
  "bin": {
    "tsx-dataflow": "dist/bin/tsx-dataflow.js",
    "tsx-dataflow-serve": "dist/bin/tsx-dataflow-serve.js"
  },
  "files": [
    "dist",
    "examples",
    "skills",
    "docs",
    "README.md"
  ],
  "scripts": {
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev": "node --import tsx scripts/dev.ts",
    "dev:server": "tsx watch --include 'src/**' --exclude 'src/frontend/**' src/server-cli.ts --port 4318",
    "dev:frontend": "vite --config vite.frontend.config.ts",
    "typecheck:server": "tsc -p tsconfig.server.json",
    "typecheck:frontend": "tsc -p src/frontend/tsconfig.json",
    "typecheck": "pnpm run typecheck:server && pnpm run typecheck:frontend",
    "build:frontend": "pnpm run typecheck:frontend && vite build --config vite.frontend.config.ts",
    "build:server": "esbuild bin/tsx-dataflow.ts bin/tsx-dataflow-serve.ts bin/analysis-worker.ts --bundle --platform=node --format=esm --packages=external --outdir=dist/bin --sourcemap",
    "build": "pnpm run build:server && pnpm run build:frontend",
    "analyze": "tsx bin/tsx-dataflow.ts",
    "benchmark:analysis": "node --import tsx scripts/benchmark-analysis.ts",
    "benchmark:workspace": "node --import tsx scripts/benchmark-workspace.ts",
    "serve": "tsx bin/tsx-dataflow-serve.ts",
    "examples:regenerate": "tsx examples/regenerate.ts",
    "prepack": "pnpm run build"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "typescript",
    "tsx",
    "solid",
    "solidstart",
    "static-analysis",
    "data-flow",
    "render-path",
    "refactoring",
    "cli"
  ],
  "license": "MIT",
  "dependencies": {
    "solid-js": "^1.8.22",
    "tsx": "^4.20.3",
    "typescript": "^5.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@solidjs/testing-library": "^0.8.10",
    "@types/node": "^20.19.0",
    "concurrently": "^9.2.0",
    "esbuild": "^0.28.1",
    "eslint": "^9.39.4",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-solid": "^0.14.5",
    "eslint-plugin-unused-imports": "^4.4.1",
    "jsdom": "^29.1.1",
    "typescript-eslint": "^8.63.0",
    "vite": "^5.4.19",
    "vite-plugin-solid": "^2.10.2",
    "vitest": "^2.0.0"
  }
}
